# Database Configuration
DATABASE_PATH=./data/tagihan-wifi.db

# Application Settings
APP_NAME=tagihan-wifi-api
APP_ENV=development
APP_DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=8000
APP_VERSION=0.1.0

# JWT Configuration
# IMPORTANT: Change SECRET_KEY to a strong random string in production!
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-environment

# Sqids Alphabet for ID encoding
# This is the alphabet used to encode/decode numeric IDs to URL-safe strings
SQIDS_ALPHABET=QnUpaur6msw2E9zF4lMvAhfbtBDS0R1NoVdxXT3qWyOkZjYPig8JK7GCIeLcH5
